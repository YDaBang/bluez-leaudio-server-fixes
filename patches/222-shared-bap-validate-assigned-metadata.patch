+/* Exact Android conversational metadata: Context 0x0002, CCID List { 0x01 }. */
+#define ENABLE_ASE_CCID(id) \
+	IOV_DATA(ENABLE_PDU(1), id, 0x07, 0x03, 0x02, 0x02, 0x00, \
+			0x02, 0x05, 0x01), \
+	IOV_DATA(0x1b, CP_HND, 0x03, 0x01, id, 0x00, 0x00)
+
+#define SCC_SRC_ENABLE_CCID \
+	SCC_SRC_16_2_1, \
+	ENABLE_ASE_CCID(SRC_ID(0)), \
+	IOV_NULL, \
+	IOV_DATA(0x1b, SRC_HND(0), SRC_ID(0), 0x03, 0x00, 0x00, 0x07, \
+			0x03, 0x02, 0x02, 0x00, 0x02, 0x05, 0x01)
+
+/* Every Generic Audio Metadata type currently assigned by Bluetooth SIG. */
+#define ASSIGNED_METADATA \
+	0x03, 0x01, 0x01, 0x00, \
+	0x03, 0x02, 0x02, 0x00, \
+	0x02, 0x03, 0x78, \
+	0x04, 0x04, 0x65, 0x6e, 0x67, \
+	0x02, 0x05, 0x01, \
+	0x02, 0x06, 0x00, \
+	0x02, 0x07, 0x78, \
+	0x02, 0x08, 0x01, \
+	0x01, 0x09, \
+	0x02, 0x0a, 0x00, \
+	0x05, 0x0b, 0x74, 0x65, 0x73, 0x74, \
+	0x03, 0xfe, 0x01, 0x00, \
+	0x03, 0xff, 0x01, 0x00
+
+#define ENABLE_ASE_ASSIGNED_METADATA(id) \
+	IOV_DATA(ENABLE_PDU(1), id, 0x2f, ASSIGNED_METADATA), \
+	IOV_DATA(0x1b, CP_HND, 0x03, 0x01, id, 0x00, 0x00)
+
+#define SCC_SRC_ENABLE_ASSIGNED_METADATA \
+	SCC_SRC_16_2_1, \
+	ENABLE_ASE_ASSIGNED_METADATA(SRC_ID(0)), \
+	IOV_NULL, \
+	IOV_DATA(0x1b, SRC_HND(0), SRC_ID(0), 0x03, 0x00, 0x00, 0x2f, \
+			ASSIGNED_METADATA)
