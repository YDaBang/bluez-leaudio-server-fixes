From: YDaBang <y_dabang@protonmail.com>
Date: Sun, 16 Aug 2026 12:25:00 +0900
Subject: [PATCH] shared/bap: validate assigned Generic Audio metadata

Android includes the standard CCID List metadata entry when enabling a
conversational unicast ASE. BlueZ recognizes only types 0x01 through 0x04 and
therefore rejects that valid request before transport acquisition.

Recognize every Generic Audio Metadata type currently assigned by Bluetooth
SIG. Validate fixed-size fields and the structural minimums for variable-size
fields, accept the zero-value Immediate Rendering flag, and continue to reject
RFU types. This also fixes the existing missing length checks for Preferred
Audio Contexts and Language.

Add server tests for the exact Android CCID payload, a valid set containing
all assigned types, malformed values at each new structural boundary, and a
genuinely RFU type (0x7f).
---

Signed-off-by: YDaBang <y_dabang@protonmail.com>

--- a/src/shared/bap.c
+++ b/src/shared/bap.c
@@ -64,6 +64,15 @@
 #define BAP_METADATA_CONTEXT_LTV_TYPE		0x02
 #define BAP_METADATA_PROGRAM_INFO_LTV_TYPE	0x03
 #define BAP_METADATA_LANGUAGE_LTV_TYPE		0x04
+#define BAP_METADATA_CCID_LIST_LTV_TYPE		0x05
+#define BAP_METADATA_PARENTAL_RATING_LTV_TYPE	0x06
+#define BAP_METADATA_PROGRAM_INFO_URI_LTV_TYPE	0x07
+#define BAP_METADATA_AUDIO_ACTIVE_STATE_LTV_TYPE	0x08
+#define BAP_METADATA_IMMEDIATE_RENDERING_LTV_TYPE	0x09
+#define BAP_METADATA_ASSISTED_LISTENING_LTV_TYPE	0x0a
+#define BAP_METADATA_BROADCAST_NAME_LTV_TYPE	0x0b
+#define BAP_METADATA_EXTENDED_LTV_TYPE		0xfe
+#define BAP_METADATA_VENDOR_LTV_TYPE		0xff
 
 struct bt_bap_pac_changed {
 	unsigned int id;
@@ -3423,6 +3432,14 @@
 	uint8_t err;
 };
 
+static void bap_metadata_invalid(struct bap_metadata_process *data,
+						uint8_t type)
+{
+	ascs_ase_rsp_add(data->rsp, data->ep->id,
+			BT_ASCS_RSP_METADATA_INVALID, type);
+	data->err = BT_ASCS_RSP_METADATA_INVALID;
+}
+
 static void bap_metadata_process(size_t i, uint8_t l, uint8_t t, uint8_t *v,
 					void *user_data)
 {
@@ -3431,25 +3448,55 @@
 
 	switch (t) {
 	case BAP_METADATA_PREF_CONTEXT_LTV_TYPE:
+		if (l != sizeof(context))
+			bap_metadata_invalid(data, t);
 		break;
 	case BAP_METADATA_CONTEXT_LTV_TYPE:
 		if (l != sizeof(context)) {
-			ascs_ase_rsp_add(data->rsp, data->ep->id,
-					BT_ASCS_RSP_METADATA_INVALID, t);
-			data->err = BT_ASCS_RSP_METADATA_INVALID;
+			bap_metadata_invalid(data, t);
 			break;
 		}
 
 		context = get_le16(v);
-		if (!context || (context & ~data->context)) {
-			ascs_ase_rsp_add(data->rsp, data->ep->id,
-					BT_ASCS_RSP_METADATA_INVALID, t);
-			data->err = BT_ASCS_RSP_METADATA_INVALID;
-		}
+		if (!context || (context & ~data->context))
+			bap_metadata_invalid(data, t);
 
 		break;
 	case BAP_METADATA_PROGRAM_INFO_LTV_TYPE:
+	case BAP_METADATA_PROGRAM_INFO_URI_LTV_TYPE:
+		break;
 	case BAP_METADATA_LANGUAGE_LTV_TYPE:
+		if (l != 3)
+			bap_metadata_invalid(data, t);
+		break;
+	case BAP_METADATA_CCID_LIST_LTV_TYPE:
+		if (!l)
+			bap_metadata_invalid(data, t);
+		break;
+	case BAP_METADATA_PARENTAL_RATING_LTV_TYPE:
+		if (l != 1)
+			bap_metadata_invalid(data, t);
+		break;
+	case BAP_METADATA_AUDIO_ACTIVE_STATE_LTV_TYPE:
+		if (l != 1 || v[0] > 1)
+			bap_metadata_invalid(data, t);
+		break;
+	case BAP_METADATA_IMMEDIATE_RENDERING_LTV_TYPE:
+		if (l)
+			bap_metadata_invalid(data, t);
+		break;
+	case BAP_METADATA_ASSISTED_LISTENING_LTV_TYPE:
+		if (l != 1 || v[0])
+			bap_metadata_invalid(data, t);
+		break;
+	case BAP_METADATA_BROADCAST_NAME_LTV_TYPE:
+		if (l < 4 || l > 128)
+			bap_metadata_invalid(data, t);
+		break;
+	case BAP_METADATA_EXTENDED_LTV_TYPE:
+	case BAP_METADATA_VENDOR_LTV_TYPE:
+		if (l < 2)
+			bap_metadata_invalid(data, t);
 		break;
 	default:
 		ascs_ase_rsp_add(data->rsp, data->ep->id,
