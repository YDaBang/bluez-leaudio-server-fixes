From: YDaBang <y_dabang@protonmail.com>
Subject: [PATCH] shared/bap: settle server-side Release when a transport IO is attached

As a Unicast Server the Release is requested by the remote, so nothing on
this side tears the transport down. stream_release() only moves the ASE to
Releasing and leaves the completion to stream_io_disconnected(), which runs
only once the socket is actually closed - and this side still holds a
reference to it. The ASE therefore stays in Releasing forever and the
remote's LE Audio watchdog tears the group down.

Detach the IO and settle to Codec Configured, mirroring what the disconnect
handler would have done. Client behaviour is unchanged.
---

Signed-off-by: YDaBang <y_dabang@protonmail.com>

--- a/src/shared/bap.c
+++ b/src/shared/bap.c
@@ -2342,6 +2342,16 @@
 			stream_set_state(stream, BT_BAP_STREAM_STATE_CONFIG);
 		else
 			stream_set_state(stream, BT_BAP_STREAM_STATE_IDLE);
+	} else if (!stream->client) {
+		/* As a server the Release was requested by the remote, so
+		 * nothing else will tear the transport down: the disconnect
+		 * handler only runs once the socket is actually closed, and
+		 * this side still holds a reference to it. Detach here and
+		 * settle, mirroring what stream_io_disconnected() would do.
+		 */
+		stream_set_state(stream, BT_BAP_STREAM_STATE_RELEASING);
+		bap_stream_io_detach(stream);
+		stream_set_state(stream, BT_BAP_STREAM_STATE_CONFIG);
 	} else
 		stream_set_state(stream, BT_BAP_STREAM_STATE_RELEASING);
 
--- a/unit/test-bap.c
+++ b/unit/test-bap.c
@@ -4098,6 +4098,60 @@
 	SRC_START, \
 	ASE_SRC_RELEASE
 
+/* Release with a transport IO attached.
+ *
+ * Every other server-side release test leaves stream->io NULL, so
+ * stream_release() always takes the "IO already down" branch and completes the
+ * transition immediately. With an IO attached the server can only leave
+ * Releasing through the IO disconnect handler, so this exercises the branch the
+ * rest of the suite never reaches.
+ */
+static void state_io_release(struct bt_bap_stream *stream,
+					uint8_t old_state, uint8_t new_state,
+					void *user_data)
+{
+	static int io_fds[2] = { -1, -1 };
+
+	switch (new_state) {
+	case BT_BAP_STREAM_STATE_STREAMING:
+		if (io_fds[0] < 0)
+			g_assert(!socketpair(AF_UNIX,
+					SOCK_SEQPACKET | SOCK_CLOEXEC, 0,
+					io_fds));
+
+		g_assert(bt_bap_stream_set_io(stream, io_fds[0]));
+		break;
+	}
+}
+
+static struct test_config cfg_src_io_release = {
+	.cc = LC3_CONFIG_16_2,
+	.qos = LC3_QOS_16_2_1,
+	.src = true,
+	.state = BT_BAP_STREAM_STATE_STREAMING,
+	.state_func = state_io_release,
+};
+
+/* The ASE has to notify Releasing (0x06) and then a settled state. Codec
+ * Configured (0x01) is what stream_io_disconnected() selects.
+ */
+#define ASE_SRC_RELEASE_SETTLES \
+	IOV_DATA(0x52, 0x22, 0x00, 0x08, 0x01, 0x03), \
+	IOV_DATA(0x1b, 0x22, 0x00, 0x08, 0x01, 0x03, 0x00, 0x00), \
+	IOV_NULL, \
+	IOV_DATA(0x1b, 0x1c, 0x00, 0x03, 0x06), \
+	IOV_NULL, \
+	IOV_DATA(0x1b, 0x1c, 0x00, 0x03, 0x01, 0x00, 0x02, 0x01, \
+			0x0a, 0x00, 0x20, 0x4e, 0x00, 0x40, 0x9c, 0x00, \
+			0x20, 0x4e, 0x00, 0x40, 0x9c, 0x00, 0x06, 0x00, \
+			0x00, 0x00, 0x00, 0x0a, 0x02, 0x01, 0x03, 0x02, \
+			0x02, 0x01, 0x03, 0x04, 0x28, 0x00)
+
+#define SCC_SRC_IO_RELEASE \
+	SCC_SRC_ENABLE, \
+	SRC_START, \
+	ASE_SRC_RELEASE_SETTLES
+
 static void state_disable_release(struct bt_bap_stream *stream,
 					uint8_t old_state, uint8_t new_state,
 					void *user_data)
@@ -4207,6 +4261,12 @@
 	define_test("BAP/USR/SCC/BV-150-C [USR SRC Release in Disabling state]",
 			test_setup_server, test_server,
 			&cfg_src_disable_release, SCC_SRC_DISABLE_RELEASE);
+	/* test_server does not register cfg->state_func; only
+	 * test_server_state does, through bap_attached_state().
+	 */
+	define_test("BAP/USR/SCC/IO-RELEASE-01 [USR SRC Release settles with IO]",
+			test_setup_server, test_server_state,
+			&cfg_src_io_release, SCC_SRC_IO_RELEASE);
 }
 
 static void test_scc_release(void)
